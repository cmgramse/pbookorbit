{
  "name": "client-data",
  "version": "1",
  "description": "Generic identifier and encoded-content rules reused from the shared client-data gate. Actual names belong only in ignored redactors/local packs. Automatic checkpoint uploads remain disabled.",
  "rules": [
    {
      "id": "advoware-case-number",
      "regex": "\\b[A-Z]{1,3}-[0-9]{2}[/_](?:[0-9]{1,4}|[0-8][0-9]{4}|9[0-8][0-9]{3}|[0-9]{6})\\b"
    },
    {
      "id": "court-file-number",
      "regex": "\\b(?:[0-9]{1,3}|[IVXL]{1,6}) ?[A-Z][A-Za-z]{0,3} [0-9]{1,5}/[0-9]{2}(?:[0-9]{2})?\\b"
    },
    {
      "id": "inline-encoded-file",
      "regex": "(?:iVBORw0KGgo|/9j/|JVBERi0|UEsDB|R0lGOD|UklGR)[A-Za-z0-9+/]{100,}={0,2}"
    },
    {
      "id": "long-encoded-run",
      "regex": "[A-Za-z0-9+/]{1000,}={0,2}"
    },
    {
      "id": "wrapped-encoded-lines",
      "regex": "(?:^|[^A-Za-z0-9+/])(?:[A-Za-z0-9+/]{40,}(?:\\\\+r)?\\\\+n[ >|\\\\t]*){6,}"
    }
  ]
}
